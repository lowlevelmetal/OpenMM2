# Script-mode helper for Shaders.cmake.
#   MODE=concat: OUTPUT = PRELUDE + INPUT
#   MODE=embed : write a C++ file embedding ENTRIES ("kind:ident:path|...")

cmake_minimum_required(VERSION 3.25)

if(MODE STREQUAL "concat")
    file(READ "${PRELUDE}" prelude)
    file(READ "${INPUT}" body)
    file(WRITE "${OUTPUT}.tmp" "${prelude}\n#line 1\n${body}")
    file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
    file(REMOVE "${OUTPUT}.tmp")

elseif(MODE STREQUAL "embed")
    string(REPLACE "|" ";" entries "${ENTRIES}")
    set(out "// Generated by cmake/ShaderTool.cmake. Do not edit.\n")
    string(APPEND out "#include <cstddef>\n#include <cstdint>\n\nnamespace mm2::render::shaders {\n")
    foreach(entry IN LISTS entries)
        string(REGEX MATCH "^([a-z]+):([A-Za-z0-9_]+):(.*)$" _ "${entry}")
        set(kind "${CMAKE_MATCH_1}")
        set(ident "${CMAKE_MATCH_2}")
        set(path "${CMAKE_MATCH_3}")
        file(READ "${path}" hex HEX)
        string(LENGTH "${hex}" hex_len)
        math(EXPR size "${hex_len} / 2")
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
        string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){24})" "\\1\n    " bytes "${bytes}")
        if(kind STREQUAL "spv")
            string(APPEND out "alignas(4) extern const std::uint8_t ${ident}_spv[] = {\n    ${bytes}\n};\n")
            string(APPEND out "extern const std::size_t ${ident}_spv_size = ${size};\n")
        else()
            # Null-terminate GLSL text.
            string(APPEND out "extern const char ${ident}_glsl[] = {\n    ${bytes} 0x00\n};\n")
        endif()
    endforeach()
    string(APPEND out "} // namespace mm2::render::shaders\n")
    file(WRITE "${OUTPUT}.tmp" "${out}")
    file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
    file(REMOVE "${OUTPUT}.tmp")

else()
    message(FATAL_ERROR "ShaderTool: unknown MODE '${MODE}'")
endif()
