// Windows resources for openmm2.exe (generated from openmm2.rc.in).
#include <winver.h>

1 ICON "@OPENMM2_ICON@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "OpenMM2 contributors"
            VALUE "FileDescription", "OpenMM2"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "openmm2"
            VALUE "LegalCopyright", "GNU GPL v3 or later"
            VALUE "OriginalFilename", "openmm2.exe"
            VALUE "ProductName", "OpenMM2"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
